import telebot
import time

TOKEN = '8793453185:AAFeIwbg7bAgalGeUSwxZ7B2wuM_8QvTn9o'
bot = telebot.TeleBot(TOKEN)

BAD_WORDS = ['хуй', 'пизд', 'блять', 'сука', 'пидор', 'мудак', 'ебал']
user_warnings = {}

@bot.message_handler(commands=['start', 'help'])
def start_message(message):
    bot.reply_to(message, "Я админ-бот. Слежу за порядком.")

@bot.message_handler(func=lambda message: True, content_types=['text'])
def check_message(message):
    if message.from_user.is_bot:
        return

    # Проверяем, админ ли это
    try:
        admins = [admin.user.id for admin in bot.get_chat_administrators(message.chat.id)]
        if message.from_user.id in admins:
            return
    except:
        pass

    text_lower = message.text.lower()
    is_bad = False

    for word in BAD_WORDS:
        if word in text_lower:
            is_bad = True
            break

    if is_bad:
        user_id = message.from_user.id
        user_name = message.from_user.username or message.from_user.first_name

        try:
            # 1. Удаляем сообщение
            bot.delete_message(message.chat.id, message.message_id)

            # 2. Считаем нарушения
            if user_id not in user_warnings:
                user_warnings[user_id] = 0
            user_warnings[user_id] += 1

            # 3. Действия
            if user_warnings[user_id] >= 3:
                # Выдаем мут на 1 час (3600 секунд)
                until_date = int(time.time()) + 3600
                bot.restrict_chat_member(
                    chat_id=message.chat.id, 
                    user_id=user_id, 
                    until_date=until_date, 
                    can_send_messages=False
                )
                bot.send_message(message.chat.id, f"@{user_name}, ты заебал! Мут на 1 час.")
                user_warnings[user_id] = 0
            else:
                bot.send_message(message.chat.id, f"@{user_name}, не матерись! Предупреждение {user_warnings[user_id]}/3.")

        except Exception as e:
            print(f"!!! ОШИБКА ТЕЛЕГРАМА !!!: {e}")
            try:
                bot.send_message(message.chat.id, f"Не могу выдать мут. Ошибка: {e}")
            except:
                pass

if __name__ == '__main__':
    print("Админ-бот (Цербер) запущен...")
    bot.polling(none_stop=True)
